# =====================================================================
# ALFA (Automated Lead & Financial Analysis) - Environment Variables
# =====================================================================

# 1. Google Gemini API Key (REQUIRED)
# Get a free or paid API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional alternative standard name)
# GOOGLE_API_KEY=your_gemini_api_key_here

# 2. Preferred Gemini Model (OPTIONAL)
# Defaults to "gemini-flash-latest" if not specified.
# Other options: "gemini-1.5-flash", "gemini-1.5-pro", "gemini-2.0-flash"
GEMINI_MODEL=gemini-flash-latest
