# ALFA Environment Variables — Copy this file to .env and fill in your values.
# Never commit a real .env file with actual credentials.
#
# Usage:
#   cp .env.example .env       (Linux / macOS)
#   copy .env.example .env     (Windows PowerShell)

# ── Required ─────────────────────────────────────────────────────────────────

# Google Gemini API key from https://aistudio.google.com/
# The settings loader also accepts GOOGLE_API_KEY as a fallback.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional ─────────────────────────────────────────────────────────────────

# Gemini model identifier. Default: gemini-flash-latest
GEMINI_MODEL=gemini-flash-latest

# Maximum number of PDFs processed concurrently (1–5). Default: 3
MAX_WORKERS=3

# Character count below which a PDF is treated as scanned and routed to the
# Gemini File/Vision API instead of the text path. Default: 2000
VISION_FALLBACK_THRESHOLD=2000

# Maximum number of pages sent to the LLM after keyword-scored filtering.
# Default: 40
MAX_RELEVANT_PAGES=40

# Maximum RPT rows the template will accept before overflow warnings fire.
# Default: 15 (generous; smaller templates may need to match their actual row count)
MAX_RPT_ROWS=15

# Maximum Litigation rows the template will accept before overflow warnings fire.
# Default: 10
MAX_LIT_ROWS=10

# Path to the domain rules / system prompt file. Default: SKILL.md
SKILL_PROMPT_PATH=SKILL.md

# Log verbosity: DEBUG | INFO | WARNING | ERROR. Default: INFO
LOG_LEVEL=INFO
